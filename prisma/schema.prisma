generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum ProductType {
  SAREE
  DRESS_MATERIAL
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  UPI
  CARD
}

enum OrderSource {
  WEBSITE
  WHATSAPP
}

model User {
  id                String             @id @default(cuid())
  name              String
  email             String?            @unique
  phone             String             @unique
  passwordHash      String
  role              Role               @default(CUSTOMER)
  addresses         Address[]
  orders            Order[]
  pushSubscriptions PushSubscription[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model PushSubscription {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model Address {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  createdAt DateTime @default(now())
}

model Product {
  id             String        @id @default(cuid())
  slug           String        @unique
  name           String
  description    String
  type           ProductType   @default(SAREE)
  price          Int
  salePrice      Int?
  images         String[]
  fabric         String
  categories     String[]
  occasions      String[]
  isNewArrival   Boolean       @default(false)
  isBestSeller   Boolean       @default(false)
  isOnSale       Boolean       @default(false)
  isActive       Boolean       @default(true)
  colors         ProductColor[]
  orderItems     OrderItem[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([type])
  @@index([isNewArrival])
  @@index([isBestSeller])
  @@index([isOnSale])
}

model ProductColor {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  name      String
  images    String[]
  stock     Int      @default(0)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, name])
  @@index([productId])
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  user          User?         @relation(fields: [userId], references: [id])
  userId        String?
  customerName  String
  phone         String
  email         String?
  addressLine1  String
  addressLine2  String?
  city          String
  state         String
  pincode       String
  items         OrderItem[]
  subtotal      Int
  total         Int
  paymentMethod PaymentMethod @default(COD)
  status        OrderStatus   @default(PENDING)
  source        OrderSource   @default(WEBSITE)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model OrderItem {
  id          String   @id @default(cuid())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  product     Product? @relation(fields: [productId], references: [id])
  productId   String?
  productName String
  image       String?
  price       Int
  quantity    Int
  color       String?
}

model Review {
  id        String   @id @default(cuid())
  name      String
  photo     String?
  rating    Int
  text      String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model WhatsAppClick {
  id          String   @id @default(cuid())
  productId   String?
  productName String?
  page        String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model SiteSettings {
  id             Int     @id @default(1)
  instagramUrl   String?
  facebookUrl    String?
  whatsappUrl    String?
  youtubeUrl     String?
  pinterestUrl   String?
  whatsappNumber String  @default("919652282268")
  contactEmail   String  @default("swathi.pisarla98@gmail.com")
  orderNotificationEmails String[] @default([])
}
